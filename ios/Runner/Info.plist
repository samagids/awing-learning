<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Awing</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>awing_ai_learning</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Export compliance: app uses only Apple's built-in HTTPS/TLS (via
	     Firestore SDK) and no custom or proprietary encryption. Setting
	     this to false tells Apple no further export-compliance answer is
	     needed for any future build, so TestFlight never blocks releases
	     with "Missing Compliance" status. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Awing Learning needs microphone access for pronunciation practice and audio recording.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Awing Learning uses speech recognition to check your Awing pronunciation.</string>
	<!-- Local-network permission: required by network_info_plus + nsd packages.
	     Used so a teacher's device can host a classroom exam session over Wi-Fi
	     and student devices can discover and join via mDNS. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Awing Learning uses your local Wi-Fi network so teachers can host classroom exam sessions and students can discover and join nearby sessions.</string>
	<!-- Location purpose string: iOS conflates Wi-Fi SSID detection with
	     location permission, so network_info_plus references CoreLocation
	     APIs even though the app never reads GPS coordinates. Apple's
	     warning 90683 requires this key when ANY referenced API needs it. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Awing Learning does not track your location. This permission is required only because the Wi-Fi network library (used by the classroom exam mode) references location APIs on iOS.</string>
	<!-- v1.17.1+ — Builds 70 & 72 received ITMS-90683 specifically calling out
	     NSLocationAlwaysAndWhenInUseUsageDescription. A transitive SDK (likely
	     a Firebase or location-adjacent plugin) references the Always API even
	     though the app never requests background location. Both keys required. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Awing Learning does not track your location. This permission is required only because a third-party library bundled with the app references the Always location API on iOS. The app never requests background location access.</string>
	<!-- Photo library + camera purpose strings.
	     v1.22.0 (Session 66) — the Contribute flow now uses image_picker to
	     attach optional photos to word corrections, pronunciation
	     recordings, translation corrections, and Study Set word entries.
	     Strings updated from the earlier "does not use" placeholders
	     (Session 57b) to accurately describe the new user-facing use.
	     Apple's App Review reads these strings verbatim at the runtime
	     permission prompt; shipping stale "does not use" language while
	     actually invoking the APIs risks ITMS-90683 or App Review
	     rejection.
	     NSPhotoLibraryAddUsageDescription stays a placeholder because the
	     app still doesn't SAVE anything back to the library — it only
	     READS via NSPhotoLibraryUsageDescription. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Awing Learning uses your photo library so you can attach a picture of a word to your correction, new-word suggestion, or pronunciation recording. Pictures help the teacher confirm the meaning.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Awing Learning does not save anything to your photo library. This permission is required only because a third-party library bundled with the app references the Photos framework.</string>
	<key>NSCameraUsageDescription</key>
	<string>Awing Learning uses your camera so you can take a photo to attach to a word correction, new-word suggestion, or pronunciation recording. Pictures help the teacher confirm the meaning.</string>
	<!-- Bonjour service types we register/browse via mDNS. The single service
	     here is the Kahoot-style exam discovery service used by exam_service.dart.
	     iOS 14+ requires every Bonjour service type to be declared here or
	     mDNS calls return no results. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_awing-exam._tcp</string>
	</array>
	<!-- Google Sign-In URL scheme — REVERSED_CLIENT_ID from
	     ios/Runner/GoogleService-Info.plist (Firebase project sanguine-frame-291822,
	     iOS app com.awing.awingAiLearning, registered Session 57b 2026-04-27).
	     Required for the Google Sign-In OAuth callback on iOS; without this URL
	     scheme, login fails silently. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1060398800208-7sokhc696fiqbtr7j6d4rmkpfotcju15</string>
			</array>
		</dict>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- v1.23.6: without this, canLaunchUrl('whatsapp://...') always returns
	     false on iOS, so Parent Settings would hide the share button even for
	     parents who do have WhatsApp. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
	</array>
</dict>
</plist>
