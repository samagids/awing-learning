# Training corpus — raw data and derived outputs are large and per-developer.
# We keep the layout docs (README.md, PROVENANCE_TEMPLATE.json) committed so
# the directory structure is documented; the actual audio/video/text files
# are not.
corpus/raw/**
!corpus/raw/README.md
!corpus/raw/**/README.md
!corpus/raw/PROVENANCE_TEMPLATE.json
!corpus/raw/.gitkeep
corpus/aligned/
corpus/manifest.jsonl
corpus/manifest_stats.json

# Contributions (approved files are temporary, applied/ is archive)
contributions/approved_contributions.json
contributions/applied/
contributions/last_version.txt
contributions/regenerate_words.json
# Per-build, per-machine artifacts from scripts/check_speakable_drift.py.
# The cache stores last-build awing_to_speakable() output for every Awing
# string; the drift list is its per-build diff feeding the targeted
# regenerate in build_and_run.sh Step 1b. Both regenerate on every build;
# tracking them would cause spurious diffs and break drift detection.
contributions/rule_drift_words.json
scripts/_speakable_cache.json

# Clasp project dirs (mostly local — .clasp.json holds private script
# IDs and Code.js is auto-mirrored from the .gs source by
# scripts/setup_and_deploy.py). We DO track each project's
# appsscript.json because it declares the OAuth scopes the deployed
# webhook needs at runtime — when scopes change (e.g. adding
# script.external_request for UrlFetchApp), the manifest update is the
# canonical record and must survive across machines.
#
# IMPORTANT: use the `dir/*` pattern (NOT `dir/`). When a directory
# itself is excluded, no `!` exception inside it can re-include files —
# git stops descending into the directory entirely.
scripts/clasp_analytics/*
scripts/clasp_contributions/*
!scripts/clasp_analytics/appsscript.json
!scripts/clasp_contributions/appsscript.json

# Large files — model and video downloads
assets/model.tflite
assets/onnx_model/
*.mp4
*.wav

# Large reference files (keep PDFs, skip huge HTML exports)
awing english.htm

# Android Gradle cache
android/.gradle/

# Secrets / keys
*.jks
*.keystore
key.properties
# google-services.json is committed — it contains public project IDs, not secrets.
# It's required by GitHub Actions CI to build the APK.
# Same rationale for iOS GoogleService-Info.plist: Firebase config keys are
# bundle-ID-restricted, designed to ship inside the binary, and required by
# CI to build a signed IPA.
GoogleService-Info.plist
!ios/Runner/GoogleService-Info.plist

# CocoaPods (rebuilt by pod install)
ios/Pods/
ios/.symlinks/
ios/Podfile.lock

# iOS large-asset bundle — populated by CI from the GitHub Release tarball
# (same role as android/install_time_assets/src/main/assets/ on Android).
# Folder reference is committed via .gitkeep so Xcode's PBXFileReference
# resolves locally, but the actual audio/image tree is gitignored.
ios/Runner/PADAssets/*
!ios/Runner/PADAssets/.gitkeep

