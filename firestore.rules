rules_version = '2';

// ===========================================================================
// Awing AI Learning — Firestore security rules
// ===========================================================================
// Document layout:
//   users/{email_sanitized}                — parent user doc
//   users/{email_sanitized}/data/{docType} — synced data (accounts, progress,
//                                            settings, ...)
// Email is sanitized in the Dart client (cloud_backup_service.dart line 63):
//   emailKey = email.toLowerCase().replaceAll('.', '_dot_')
//
// SECURITY MODEL (locked down):
//   • Each authenticated user may read/write ONLY their own /users/{emailKey}
//     document and the /data/{docType} subcollection beneath it. They cannot
//     enumerate other users or read another user's progress.
//   • Developer (samagids@gmail.com) is the only account that can read ALL
//     users' data — used by the Developer Mode > Users tab via a collection
//     group query.
//   • No one can write to anyone else's document, ever.
//
// IMPORTANT: collection group queries (collectionGroup('data')) DO NOT
// inherit from path-based rules. They need their own /{path=**}/data/...
// rule. Developer Mode > Users tab uses a collection group query to list
// all cloud-synced users — without the third match below it fails with
//   [cloud_firestore/permission-denied]
//
// Email-to-userId mapping function MUST mirror cloud_backup_service.dart
// exactly. If that file's _userDocPath() ever changes, this function and
// the matching rules must be updated in lockstep.
//
// To deploy:
//   1. Open https://console.firebase.google.com/
//   2. Project > Firestore Database > Rules tab
//   3. Paste the contents of this file
//   4. Click "Publish"
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Compute the sanitized email key the client uses to derive a userId.
    // Matches cloud_backup_service.dart `_userDocPath()`:
    //   emailKey = email.toLowerCase().replaceAll('.', '_dot_')
    function emailKey() {
      return request.auth != null
          ? request.auth.token.email.lower().replace('\\.', '_dot_')
          : '';
    }

    // Developer override — samagids@gmail.com sees everything.
    function isDeveloper() {
      return request.auth != null
          && request.auth.token.email == 'samagids@gmail.com';
    }

    // Per-user data: users may read/write ONLY their own document.
    // The path's {userId} segment is the sanitized email key. We compare
    // it to the requesting user's email-derived key to enforce isolation.
    match /users/{userId}/data/{docType} {
      allow read, write: if request.auth != null
                         && (userId == emailKey() || isDeveloper());
    }

    // Parent user doc: same isolation. Developer can also read for the
    // Users tab listing.
    match /users/{userId} {
      allow read: if request.auth != null
                  && (userId == emailKey() || isDeveloper());
      allow write: if request.auth != null
                   && userId == emailKey();
    }

    // Collection group query support — Developer Mode > Users tab uses
    // collectionGroup('data').get() to enumerate all cloud-synced users.
    // Restrict to the developer email so only the dev account can list
    // every user's data.
    match /{path=**}/data/{dataDoc} {
      allow read: if isDeveloper();
    }

    // Session 63 — Study Sets (Phase 2).
    //
    // Study sets are teacher-owned curated wordlists that can be shared
    // with a roster of student Google accounts. The owner (teacher)
    // has full read/write. Students on the sharedWithEmails roster get
    // read access so they can browse the set. Nobody else can access.
    //
    // Schema:
    //   teacherEmail:     string, the owner's Google email (immutable)
    //   sharedWithEmails: [string], student Google emails on the roster
    //   name, description, wordKeys, customWords, recordings, ...
    // v1.21.4 (Session 65) — partnerEmails added:
    //   partnerEmails: [string], teacher co-owner Google emails
    // Partners get full read+write (same as creator) EXCEPT:
    //   - Only the creator can delete the set
    //   - Only the creator can add/remove other partners
    // These extra restrictions are enforced by the client (see
    // StudySet.canManagePartners / delete flow in the list screen).
    // Firestore rules only guard READ/WRITE at the doc level; the
    // finer-grained "partner can't manage other partners" is enforced
    // via the update rule's data-diff check below.
    match /study_sets/{setId} {
      // Emails compared case-insensitively — client stores lowercased
      // teacherEmail + roster, but Google's auth token.email preserves
      // the user's original case. Lowercase both sides of every
      // comparison here so a student signed in as "Kid@Gmail.com" still
      // matches a roster entry stored as "kid@gmail.com".
      allow read: if request.auth != null
                  && (resource.data.teacherEmail.lower() == request.auth.token.email.lower()
                      || request.auth.token.email.lower() in resource.data.sharedWithEmails
                      || request.auth.token.email.lower() in resource.data.partnerEmails
                      || isDeveloper());
      allow create: if request.auth != null
                    && request.resource.data.teacherEmail.lower() == request.auth.token.email.lower();
      // Update: creator OR partner (with restrictions).
      //
      // Creator: full update access, may change any field.
      //
      // Partner: may edit words, recordings, description, roster, etc.
      // Must NOT change teacherEmail (creator is immutable).
      // Must NOT add other partners or remove someone else — the ONLY
      // permitted partnerEmails delta is "unchanged" or "remove self"
      // (self-service leave via StudySetService.leavePartneredSet).
      //
      // The size + hasAll check below encodes:
      //   • new partnerEmails is a subset of old (no additions), AND
      //   • exactly one item was removed, AND
      //   • that item is the caller (self is not in new list)
      // Any other delta (removing someone else) fails the rule.
      allow update: if request.auth != null
                    && (
                      // Creator: unrestricted update.
                      resource.data.teacherEmail.lower() == request.auth.token.email.lower()
                      // Partner: restricted update.
                      || (
                        request.auth.token.email.lower() in resource.data.partnerEmails
                        && request.resource.data.teacherEmail == resource.data.teacherEmail
                        && (
                          // Partnering unchanged (editing words etc.)
                          request.resource.data.partnerEmails == resource.data.partnerEmails
                          // Or partner is leaving (removing self only).
                          || (
                            resource.data.partnerEmails.hasAll(request.resource.data.partnerEmails)
                            && !(request.auth.token.email.lower() in request.resource.data.partnerEmails)
                            && resource.data.partnerEmails.size() - request.resource.data.partnerEmails.size() == 1
                          )
                        )
                      )
                    );
      // Only the creator can delete.
      allow delete: if request.auth != null
                    && resource.data.teacherEmail.lower() == request.auth.token.email.lower();
    }

    // Session 61 — G6 security hardening.
    //
    // Audit log: append-only record of every developer bulk-read of user
    // data. The Developer Mode > Users tab is a single point of compromise
    // (if samagids@gmail.com is ever phished, all tester progress is
    // readable). The audit log creates accountability: we can later answer
    // "did the dev account read user X's data, and when?".
    //
    // Schema (enforced by request.resource.data.keys().hasAll(...)):
    //   email:     who did the read (request.auth.token.email)
    //   action:    "bulk_read_users" | "read_single_user" | "delete_user"
    //   timestamp: ISO 8601 string written by the client
    //   userCount: how many user docs were touched (integer)
    //   userIds:   optional list of affected userId strings (for single
    //              reads; omitted for bulk reads to keep doc size small)
    //
    // Rules:
    //   create: dev only, and the email field MUST match the caller's
    //           auth token email (prevents the dev from impersonating
    //           another email in the log).
    //   read:   dev only.
    //   update: NEVER. Even the dev can't rewrite history.
    //   delete: NEVER. Logs are immutable for forensics.
    match /audit/{auditId} {
      allow create: if isDeveloper()
                    && request.resource.data.keys().hasAll(
                         ['email', 'action', 'timestamp', 'userCount'])
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.action is string
                    && request.resource.data.userCount is int;
      allow read: if isDeveloper();
      allow update, delete: if false;
    }

    // Session 61b — native-speaker recording inventory.
    //
    // Cross-device tracking of which Awing words/phrases/sentences have been
    // recorded by whom. Each document represents one recording of one
    // Awing item by one user, from one device, at one point in time.
    //
    // Schema:
    //   awing:            the Awing text recorded (e.g. "apô")
    //   english:          English meaning at time of recording
    //   source:           "word" | "phrase" | "letter" | "sentence" | "story"
    //   audio_key:        normalized filename stem (matches generate_audio_edge.py)
    //   category:         optional category tag (for filtering)
    //   recorded_by_email: email of the recorder (must match auth)
    //   recorded_by_name: display name at time of recording
    //   recorded_at:      Timestamp
    //   device:           platform string ("Pixel Tablet", "Windows desktop")
    //   drive_url:        populated after audio uploaded to Drive
    //   duration_ms:      length of the recording
    //   contribution_id:  link to /contributions row if applicable
    //
    // Rules:
    //   read:   any signed-in user (so anyone using the family/dev recorder
    //           can see what's already done, avoiding duplicate work).
    //   create: signed-in user, AND recorded_by_email must equal their own
    //           auth email (no impersonation), AND required fields present
    //           with correct types.
    //   update: developer only OR the original recorder (to add drive_url
    //           after the upload completes).
    //   delete: developer only (forensics-friendly; recorders can't hide
    //           bad recordings, only the dev can prune).
    match /recordings/{recId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasAll(
                         ['awing', 'source', 'audio_key',
                          'recorded_by_email', 'recorded_at'])
                    && request.resource.data.recorded_by_email ==
                       request.auth.token.email
                    && request.resource.data.awing is string
                    && request.resource.data.source is string
                    && request.resource.data.audio_key is string;
      allow update: if request.auth != null
                    && (resource.data.recorded_by_email ==
                          request.auth.token.email
                        || isDeveloper());
      allow delete: if isDeveloper();
    }
  }
}
