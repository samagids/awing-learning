# Line-ending policy — deliberately NARROW.
#
# `* text=auto` is the usual advice and is wrong for this repo: it would
# renormalise every tracked text file on the next checkin, producing a
# whole-repo diff that buries real changes and makes every later `git blame`
# useless. This file therefore names only the paths that actually churn.
#
# `-text` means: never convert, store and check out the bytes as they are.
# That is what stops a file from showing as fully rewritten on a machine
# whose editor or generator writes the other line ending.

# Generated on Windows, regenerated by the build, 8,911 lines. Has shown as
# "8911 added / 8911 removed" with zero content change for months.
android/install_time_assets/src/main/assets/vocab_embeddings_keys.txt -text

# Pipeline reports — written by Python on Windows, read by nothing that
# cares about line endings.
contributions/*.json -text
contributions/*.csv  -text
contributions/*.txt  -text

# Vendored dependencies. These should not be tracked at all, but while they
# are, keep them out of the diff.
cf-worker/node_modules/** -text -diff linguist-vendored

# Binary assets — never diff or convert these.
*.webp binary
*.opus binary
*.wav  binary
*.mp3  binary
*.m4a  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.tflite binary
*.bin  binary

# ---- Second pass: the remaining churners ----------------------------------

# Generated files. family_recorder.html is emitted by
# scripts/build_family_recorder.py from the template below it; pubspec.lock is
# emitted by Flutter. Both are written with CRLF on this machine and have
# shown as fully rewritten with zero content change.
family_recorder.html -text
pubspec.lock         -text

# Hand-edited, but edited on Windows. The template is a sibling of the
# generated file above and must keep the same endings.
scripts/family_recorder_template.html -text

# Windows shells genuinely need CRLF. Pin it rather than leaving it to
# core.autocrlf, so the bytes are the same on every clone.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# This one has a shebang, so it must stay LF or `./build_family_recorder.py`
# fails with "bad interpreter: /usr/bin/env python3^M" under WSL.
scripts/build_family_recorder.py text eol=lf
